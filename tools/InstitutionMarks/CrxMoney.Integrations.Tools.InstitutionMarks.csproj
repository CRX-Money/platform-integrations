<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>CrxMoney.Integrations.Tools.InstitutionMarks</RootNamespace>
    <AssemblyName>CrxMoney.Integrations.Tools.InstitutionMarks</AssemblyName>
    <!-- A maintainer tool, never shipped. -->
    <IsPackable>false</IsPackable>
    <!-- The id of the dotnet user-secrets store that keeps the Pluggy credentials out of the repository (see the package README). -->
    <UserSecretsId>crx-money-institution-marks</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Svg.Skia" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Countries\br\CrxMoney.Integrations.Countries.Br.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrxMoney.Integrations.Tools.InstitutionMarks.Tests" />
  </ItemGroup>

</Project>
