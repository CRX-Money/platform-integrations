<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>CrxMoney.Integrations.Countries.Br</PackageId>
    <Description>Brazil building blocks for CRX•Money Platform integrations: CPF/CNPJ validation (alphanumeric CNPJ included), bank-account identity, the Brazilian banking calendar, and the list of account operators (COMPE code to name and website). Shared by the Brazilian provider plugins.</Description>
    <PackageTags>$(PackageTags);brazil;open-finance;openfinance-brasil;cpf;cnpj</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!-- Local data of the country package: COMPE code -> account operator name and website. -->
    <EmbeddedResource Include="Data\br-institutions.json" LogicalName="CrxMoney.Integrations.Countries.Br.br-institutions.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Marks (logos) of the account operators and the manifest of where each came from; see README. -->
    <EmbeddedResource Include="Marks\*.svg;Marks\*.png;Marks\marks-manifest.json" LogicalName="CrxMoney.Integrations.Countries.Br.marks.%(Filename)%(Extension)" />
    <!-- Marks of business (PJ) connectors, by the aggregator's connector id (#1379). -->
    <EmbeddedResource Include="Marks\connectors\*.svg;Marks\connectors\*.png" LogicalName="CrxMoney.Integrations.Countries.Br.marks.connectors.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Abstractions\CrxMoney.Integrations.Abstractions\CrxMoney.Integrations.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrxMoney.Integrations.Countries.Br.Tests" />
  </ItemGroup>

</Project>
