<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>CrxMoney.Integrations.Countries.Br</PackageId>
    <Description>Brazil building blocks for CRX•Money Platform integrations: CPF/CNPJ validation (alphanumeric CNPJ included), bank-account identity, the Brazilian banking calendar, and an aggregator-neutral Open Finance Brasil transaction model with one mapper to the platform's import events.</Description>
    <PackageTags>$(PackageTags);brazil;open-finance;openfinance-brasil;cpf;cnpj</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Abstractions\CrxMoney.Integrations.Abstractions\CrxMoney.Integrations.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrxMoney.Integrations.Countries.Br.Tests" />
  </ItemGroup>

</Project>
