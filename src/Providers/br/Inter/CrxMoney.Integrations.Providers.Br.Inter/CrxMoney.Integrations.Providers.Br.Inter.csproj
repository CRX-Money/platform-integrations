<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>CrxMoney.Integrations.Providers.Br.Inter</PackageId>
    <Description>CRX•Money Platform integration for Banco Inter (Inter Empresas Banking API): syncs the enriched account statement, with counterparty CPF/CNPJ and Pix end-to-end ids, over OAuth2 client credentials and mutual TLS.</Description>
    <PackageTags>$(PackageTags);brazil;inter;banco-inter;pix</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Abstractions\CrxMoney.Integrations.Abstractions\CrxMoney.Integrations.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrxMoney.Integrations.Providers.Br.Inter.Tests" />
  </ItemGroup>

</Project>
