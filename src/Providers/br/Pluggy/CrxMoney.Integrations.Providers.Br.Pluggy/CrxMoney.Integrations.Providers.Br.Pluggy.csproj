<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>CrxMoney.Integrations.Providers.Br.Pluggy</PackageId>
    <Description>CRX•Money Platform integration for Pluggy, a Brazilian Open Finance aggregator: reads connected bank accounts, cards and investments through the Pluggy API and hands them to the aggregator-neutral Open Finance model in CrxMoney.Integrations.Countries.Br.</Description>
    <PackageTags>$(PackageTags);brazil;open-finance;pluggy</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Countries\br\CrxMoney.Integrations.Countries.Br.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrxMoney.Integrations.Providers.Br.Pluggy.Tests" />
  </ItemGroup>

</Project>
