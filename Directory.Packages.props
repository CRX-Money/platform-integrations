<Project>
  <!-- Central package management: versions live here, project files reference packages without a version. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Build">
    <PackageVersion Include="MinVer" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Label="Providers">
    <!--
      Plugins load into the CRX•Money hosts, so keep these at or below what the hosts run: a higher
      minimum here would force a host upgrade. Resilience also brings the Microsoft.Extensions
      DependencyInjection, Logging and Options abstractions the providers use.
    -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Tools">
    <!-- tools/InstitutionMarks renders the institution marks to find their content bounds and to draw the contact sheet. -->
    <PackageVersion Include="Svg.Skia" Version="5.2.3" />
    <!-- SkiaSharp is pinned explicitly so that it and the Linux native library (CI; Windows and macOS get theirs with
         SkiaSharp itself) always move together: Svg.Skia only sets a floor, and a native library newer than the managed
         binding fails at start-up on Linux ("The version of the native libSkiaSharp library ... is incompatible").
         SkiaSharpVersionsTests fails when the two versions differ; Dependabot bumps both in the same group PR. -->
    <PackageVersion Include="SkiaSharp" Version="4.148.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.148.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="PublicApiGenerator" Version="11.5.4" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
