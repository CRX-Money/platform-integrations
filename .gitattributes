# Normalise text to LF in the repository; check out with the platform's native endings.
* text=auto

*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Statement fixtures are compared byte for byte; never rewrite their line endings.
*.ofx -text
*.qfx -text
*.pdf binary

# Marks are compared by hash; never rewrite their bytes.
src/Countries/br/Marks/*.svg -text
src/Countries/br/Marks/*.png binary
